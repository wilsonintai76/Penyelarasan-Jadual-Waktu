							<script>
	document.addEventListener('DOMContentLoaded', function () {
    const fieldsets1 = document.querySelectorAll('fieldset[id^="n"]'); // Semua fieldset kolum 1
    const fieldsets2 = document.querySelectorAll('fieldset[id^="m"]'); // Semua fieldset kolum 2

    // Pastikan jumlah sama
    if (fieldsets1.length === fieldsets2.length) {
        fieldsets1.forEach((fs1, index) => {
            const fs2 = fieldsets2[index]; 
            if (fs2) {
                // Ambil tinggi maksimum antara 2 fieldset
                const maxHeight = Math.max(fs1.offsetHeight, fs2.offsetHeight);
                fs1.style.height = maxHeight - 10 + 'px';
                fs2.style.height = maxHeight - 10 + 'px';
            }
        });
    } else {
        console.error("Jumlah fieldset kolum 1 dan kolum 2 tak sama.");
    }
});

	
</script>
                            
                            
                            
                    
                    
                    
                
                    
                    
                            
                            
                            
                            
                                
                                
                                
                                
