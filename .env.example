# Cloudflare Workers AI credentials for local PDF extraction.
# The deployed Worker uses its `AI` binding instead; these are only read by server.ts.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Optional Workers AI vision model override (default: @cf/meta/llama-4-scout-17b-16e-instruct)
CF_VISION_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional External Timetable Source (Read-Only Live Fetch)
# Paste a Google Sheet "Publish to web -> CSV" URL for instant live updates without redeploying:
VITE_TIMETABLE_CSV_URL=""
# Optional custom external JSON endpoint (defaults to /data/jadual.json):
VITE_TIMETABLE_JSON_URL="/data/jadual.json"

# Admin PIN for Coordinator upload/settings access (Cloudflare & Express):
# Leave blank to use KV-managed PIN (initial default PIN: 2026)
ADMIN_PIN=""

