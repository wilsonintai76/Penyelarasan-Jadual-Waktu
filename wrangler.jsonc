{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jkm-penyelarasan-jadual",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",

  // Built SPA (vite build -> dist). /api/* is handled by the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Live timetable store used by /api/jadual, /api/jadual-history, /api/settings,
  // /api/admin-pin, /api/verify-pin and /api/logo.
  "kv_namespaces": [
    {
      "binding": "JADUAL_KV",
      "id": "406200f4735d4dbd9ee78b49f0802874"
    }
  ],

  // Custom logo storage used by /api/logo.
  "r2_buckets": [
    {
      "binding": "JADUAL_R2",
      "bucket_name": "jkm-timetable-r2"
    }
  ],

  // Fallback OCR/extraction path for /api/extract-pdf when GEMINI_API_KEY is absent.
  "ai": {
    "binding": "AI"
  },

  "observability": {
    "enabled": true
  }
}
